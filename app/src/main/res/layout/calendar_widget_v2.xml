<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- 顶栏同时显示自动更新的系统时钟、今天日期和手动刷新按钮。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextClock
            android:id="@+id/widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:textColor="@color/accent"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="@string/widget_refresh"
            android:textColor="@color/ink"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- 天气仍然只提供手机系统天气入口，不引入新的联网来源。 -->
    <TextView
        android:id="@+id/widget_weather"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center_vertical"
        android:text="@string/widget_weather_default"
        android:textColor="#687086"
        android:textSize="11sp" />

    <!-- 系统原生列表按组件可用高度显示事项，内容超出后可直接上下滑动浏览。 -->
    <ListView
        android:id="@+id/widget_event_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:scrollbars="none" />

    <!-- 没有符合显示规则的事项时，用单独空状态替代动态事项行。 -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/widget_empty"
        android:textColor="#73798A"
        android:textSize="14sp" />
</LinearLayout>
