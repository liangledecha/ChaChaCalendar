<?xml version="1.0" encoding="utf-8"?>
<!-- 原生远程布局以权重适配启动器分配的空间，背景透明而文字不透明。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp"
    android:paddingTop="8dp" android:paddingBottom="8dp"
    android:background="@drawable/grid_widget_background">
    <!-- 标题与两个动作各自拥有点击区域；动作触摸面积为四十八密度像素。 -->
    <LinearLayout android:id="@+id/grid_widget_header" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/grid_widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/grid_widget_text" android:textSize="18sp" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <TextView android:id="@+id/grid_widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/grid_widget_secondary" android:textSize="10sp"
                android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        </LinearLayout>
        <TextView android:id="@+id/grid_widget_refresh" android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:text="@string/widget_refresh" android:textSize="23sp"
            android:contentDescription="@string/widget_refresh_description" android:textColor="@color/grid_widget_secondary" />
        <TextView android:id="@+id/grid_widget_add" android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:text="@string/widget_add" android:textSize="25sp"
            android:contentDescription="@string/widget_add_description" android:textColor="@color/grid_widget_text" />
    </LinearLayout>
    <LinearLayout android:id="@+id/grid_widget_calendar" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" />
</LinearLayout>
