<!-- 安卓十二起使用桌面网格指定四乘四，旧版本按最小尺寸估算。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_week_description"
    android:initialLayout="@layout/widget_week_calendar"
